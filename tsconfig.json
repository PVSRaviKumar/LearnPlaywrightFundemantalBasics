// tsconfig.json
{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2020"
        ],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": false,
        "types": [
            "node",
            "@playwright/test"
        ],
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "tests/**/*.ts",
        "playwright.config.ts",
        "Utils/**/*.ts",
        "Utils/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}